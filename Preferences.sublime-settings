{
    "theme": "Adaptive.sublime-theme",
    "ignored_packages": [
        "Rust",
        "Vintage",
    ],
    "font_face": "Iosevka",
    "font_size": 13,
    "margin": 0,
    "translate_tabs_to_spaces": true,
    "trim_automatic_white_space": false,
    "draw_minimap_border": true,
    "always_show_minimap_viewport": false, // Maybe change this to true?
    "highlight_line": false, // Maybe change this to true?
    "caret_style": "solid",
    "block_caret": true,
    "draw_white_space": [
        "selection",
        "trailing",
        "leading_mixed",
    ],
    "trim_trailing_white_space_on_save": "not_on_caret",
    "trim_only_modified_white_space": true,
    "default_line_ending": "unix",
    "auto_complete_use_history": true,
    "shift_tab_unindent": true,
    "drag_text": false,
    "show_encoding": true,
    "show_line_endings": true,
    "hardware_acceleration": "opengl",
    "remember_full_screen": true,
    "remember_layout": true,
    "show_rel_path": true,
    "index_files": true,
    "color_scheme": "Mariana.sublime-color-scheme",
    "file_exclude_patterns": [],
    "binary_file_patterns": [
        "*.jpg",
        "*.jpeg",
        "*.png",
        "*.gif",
        "*.ttf",
        "*.tga",
        "*.dds",
        "*.ico",
        "*.eot",
        "*.pdf",
        "*.swf",
        "*.jar",
        "*.zip",
        "*.pyc",
        "*.pyo",
        "*.exe",
        "*.dll",
        "*.obj",
        "*.o",
        "*.a",
        "*.lib",
        "*.so",
        "*.dylib",
        "*.ncb",
        "*.sdf",
        "*.suo",
        "*.pdb",
        "*.idb",
        ".DS_Store",
        ".directory",
        "desktop.ini",
        "*.class",
        "*.psd",
        "*.db"
    ],
    "file_icon_theme": "A File Icon (Mono).sublime-file-icons",
}
